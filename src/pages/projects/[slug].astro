---
import type { GetStaticPaths } from 'astro';
import Project from '../../views/Project.astro';
import { projectsIn } from '../../lib/content';

export const getStaticPaths = (async () =>
  (await projectsIn('en')).map((p) => ({ params: { slug: p.slug } }))) satisfies GetStaticPaths;

const { slug } = Astro.params;
---

<Project lang="en" slug={slug} />
