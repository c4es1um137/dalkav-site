---
import type { GetStaticPaths } from 'astro';
import Note from '../../../views/Note.astro';
import { notesIn } from '../../../lib/content';

export const getStaticPaths = (async () =>
  (await notesIn('tr')).map((n) => ({ params: { slug: n.slug } }))) satisfies GetStaticPaths;

const { slug } = Astro.params;
---

<Note lang="tr" slug={slug} />
