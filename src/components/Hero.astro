---
// Home hero: the only parallax element on the site (CSS scroll-driven, §3.4).
// The starred phrase in home.h1 gets the accent gradient.
import Button from './Button.astro';
import { site } from '../config/site';
import { localizePath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const parts = t(lang, 'home.h1').split(/\*([^*]+)\*/);
---

<section class="hero relative overflow-hidden" aria-labelledby="hero-title">
  <div class="hero-parallax container pt-16 pb-16 md:pt-24 md:pb-24 lg:pt-32 lg:pb-32">
    <p class="pill mb-8 border-[rgba(94,106,210,0.4)] bg-[rgba(94,106,210,0.08)] px-3 py-1.5 text-[#9EA5F0]">
      <span class="relative flex size-2" aria-hidden="true">
        <span class="size-2 rounded-full bg-[#7C85E3] shadow-[0_0_12px_rgba(124,133,227,0.8)]"></span>
      </span>
      {t(lang, 'home.badge')}
    </p>
    <p class="label-text mb-6 text-accent-text">{t(lang, 'home.label')}</p>
    <h1
      id="hero-title"
      class="text-gradient-headline max-w-5xl pb-2 text-4xl leading-[1.05] font-semibold tracking-[-0.03em] md:text-5xl lg:text-7xl xl:text-8xl"
    >
      {parts.map((part, i) => (i % 2 === 1 ? <span class="text-gradient-accent">{part}</span> : part))}
    </h1>
    <p class="mt-8 max-w-3xl text-base leading-relaxed text-foreground-muted md:text-lg lg:text-xl">{t(lang, 'home.lead')}</p>
    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <Button href={site.cv[lang]} variant="primary" icon="download" type="application/pdf">{t(lang, 'cta.downloadCv')}</Button>
      <Button href={localizePath('/projects', lang)} variant="secondary" iconEnd="arrow-right">{t(lang, 'cta.viewProjects')}</Button>
    </div>
    <p class="label-text mt-10 text-foreground-muted">{t(lang, 'home.meta')}</p>
  </div>
</section>
