---
// Whole card is one link (stretched title link), so its accessible name is the title.
// Other-language entries carry a language badge, hreflang, and lang on the title.
import Cover from './Cover.astro';
import { t, upper, type Lang } from '../i18n';
import { formatPeriod, type Project } from '../lib/content';

interface Props {
  project: Project;
  /** Language of the page the card is on. */
  lang: Lang;
  class?: string;
  /** Large layout for the hero (4×2) and tall (2×2) cells. */
  large?: boolean;
  headingLevel?: 2 | 3;
}

const { project, lang, class: className = '', large = false, headingLevel = 3 } = Astro.props;
const { data } = project;
const foreign = project.lang !== lang;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const statusLabel = t(lang, data.status === 'ongoing' ? 'status.ongoing' : 'status.completed');
---

<article class={`card card-interactive flex h-full flex-col gap-5 p-5 md:p-6 ${className}`} data-reveal>
  <div class={`card-cover aspect-[1200/630] lg:aspect-auto lg:flex-1 ${large ? 'lg:min-h-56' : 'lg:min-h-36'}`}>
    <Cover src={data.cover} alt="" sizes={large ? '(min-width: 1024px) 60vw, 100vw' : '(min-width: 1024px) 33vw, 100vw'} />
  </div>
  <div class="flex flex-col gap-3">
    <div class="flex flex-wrap items-center gap-2">
      <span class="pill">
        <span class={`size-1.5 rounded-full ${data.status === 'ongoing' ? 'bg-[#9FD4B0]' : 'bg-[#8A8F98]'}`} aria-hidden="true"></span>
        {statusLabel}
      </span>
      {data.period && <span class="label-text text-foreground-muted">{formatPeriod(data.period, lang)}</span>}
      {foreign && <span class="pill" lang={project.lang}>{upper(project.lang, lang)}</span>}
      {data.draft && <span class="pill border-[rgba(245,184,61,0.5)] text-[#F5B83D]">{t(lang, 'draft')}</span>}
    </div>
    <Heading class="text-xl leading-snug font-semibold tracking-tight text-foreground md:text-2xl">
      <a href={project.url} class="card-link" hreflang={foreign ? project.lang : undefined} lang={foreign ? project.lang : undefined}>
        {data.title}
      </a>
    </Heading>
    <p class="text-sm leading-relaxed text-foreground-muted md:text-base" lang={foreign ? project.lang : undefined}>{data.summary}</p>
    {
      data.role && (
        <p class="text-sm text-foreground-muted">
          <span class="sr-only">{t(lang, 'projects.role')}: </span><span class="text-[#C6C9D0]" lang={foreign ? project.lang : undefined}>{data.role}</span>
        </p>
      )
    }
    {
      data.tags.length > 0 && (
        <ul class="flex flex-wrap gap-2" aria-label={t(lang, 'projects.tags')}>
          {data.tags.slice(0, 3).map((tag) => (
            <li>
              <span class="pill">#{tag}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
