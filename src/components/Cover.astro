---
// Project cover. SVG diagrams pass through untouched (crisp at any size);
// photos become responsive AVIF/WebP with width/height and EXIF stripped.
import type { ImageMetadata } from 'astro';
import { Image, Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** LCP candidate: load eagerly with high priority. */
  priority?: boolean;
  sizes?: string;
  class?: string;
}

const { src, alt, priority = false, sizes = '(min-width: 1024px) 66vw, 100vw', class: className = '' } = Astro.props;
const loading = priority ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : 'auto';
---

{
  src.format === 'svg' ? (
    <Image src={src} alt={alt} format="svg" loading={loading} fetchpriority={fetchpriority} decoding="async" class={className} />
  ) : (
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200, 1600].filter((w) => w <= src.width)}
      sizes={sizes}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      class={className}
    />
  )
}
