---
// Ambient layers (§3.1, §3.4): base gradient, noise, animated blobs, 64px grid.
// CSS only. Blobs animate transform on their own layers; below 768px only the
// primary and secondary blobs render. Reduced motion / "Pause animations"
// freezes them at their first frame (still visible).
---

<div class="ambient" aria-hidden="true">
  <div class="blob blob-primary"></div>
  <div class="blob blob-secondary"></div>
  <div class="blob blob-tertiary"></div>
  <div class="blob-bottom blob"></div>
  <div class="ambient-noise"></div>
  <div class="ambient-grid"></div>
</div>
